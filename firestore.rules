rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isManager() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidOrderCreation() {
      let data = request.resource.data;
      return
        data.keys().hasAll(['items', 'totalAmount', 'orderStatus', 'customerInfo', 'accessToken']) &&
        data.items.size() > 0 &&
        data.totalAmount > 0 &&
        (data.orderStatus == 'pending' || data.orderStatus == 'new') &&
        data.customerInfo.keys().hasAll(['firstName']) &&
        data.accessToken is string;
    }

    function isValidStockUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return
        changedKeys.hasOnly(['stock', 'totalStock', 'variants', 'updatedAt', 'salesCount', 'stockHistory', 'lastStockReason']) &&
        (!changedKeys.hasAny(['stock']) ||
          (request.resource.data.stock is number && request.resource.data.stock >= 0)) &&
        (!changedKeys.hasAny(['variants']) ||
          request.resource.data.variants is list) &&
        (!changedKeys.hasAny(['totalStock']) ||
          (request.resource.data.totalStock is number && request.resource.data.totalStock >= 0)) &&
        (!changedKeys.hasAny(['stockHistory']) ||
          request.resource.data.stockHistory is list);
    }

    function isValidReview() {
      let data = request.resource.data;
      return data.keys().hasAll(['productId', 'rating', 'text', 'createdAt', 'userName']) &&
        data.rating is number &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.text is string &&
        data.text.size() >= 5 &&
        data.text.size() <= 1000 &&
        data.productId is string &&
        data.userName is string &&
        data.userName.size() >= 1 &&
        data.userName.size() <= 50;
    }

    // 1. Users
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdminOrManager();
    }

    // 2. Products
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdminOrManager() || isValidStockUpdate();
    }

    // 3. Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 4. Orders
    match /orders/{orderId} {
      allow create: if
        isAdminOrManager() ||
        (
          isValidOrderCreation() &&
          (
            (isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
            (
              (!request.resource.data.keys().has('userId') || request.resource.data.userId == null) &&
              request.resource.data.customerInfo.isGuest == true
            )
          )
        );
      allow read: if
        isAdminOrManager() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (resource.data.customerInfo.isGuest == true) ||
        (request.query.accessToken.size() == 1 &&
          resource.data.accessToken == request.query.accessToken[0]);
      allow update: if isAdminOrManager();
      allow delete: if isAdmin();
    }

    // 5. Carts & userCarts
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdminOrManager();
    }
    match /userCarts/{userId} {
      allow read, write: if isOwner(userId) || isAdminOrManager();
    }

    // 6. Mail
    match /mail/{emailId} {
      allow create: if true;
      allow read: if false;
    }

    // 7. Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidReview();
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // 8. Blog Posts
    match /blogPosts/{postId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 9. Stock Notifications
    match /stockNotifications/{docId} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

  }
}
